# CSS/JS use content versions and optimized images/fonts use content hashes.
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|webp|woff2|woff|ttf|svg|png|jpe?g|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/x-javascript application/json application/ld+json application/xml text/xml image/svg+xml
</IfModule>
